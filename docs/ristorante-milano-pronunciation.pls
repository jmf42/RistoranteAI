<?xml version="1.0" encoding="UTF-8"?>
<lexicon version="1.0"
  xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.w3.org/2005/01/pronunciation-lexicon http://www.w3.org/TR/2007/CR-pronunciation-lexicon-20071212/pls.xsd"
  xml:lang="it-IT">

  <!--
    Ristorante AI pronunciation dictionary for Milan-specific terms.
    Use alias entries for Italian with v3 voices.
    Keep the file small and only include words that are often mispronounced.

    Tier 1 = must-have
    Tier 2 = strongly recommended
    Tier 3 = optional
  -->

  <!-- Tier 1: restaurant and immediate location -->
  <lexeme>
    <grapheme>Madonnina</grapheme>
    <alias>Madonnìna</alias>
  </lexeme>
  <lexeme>
    <grapheme>Trattoria Madonnina</grapheme>
    <alias>Trattoria Madonnìna</alias>
  </lexeme>
  <lexeme>
    <grapheme>Gentilino</grapheme>
    <alias>Gentilìno</alias>
  </lexeme>
  <lexeme>
    <grapheme>Via Gentilino</grapheme>
    <alias>Via Gentilìno</alias>
  </lexeme>
  <lexeme>
    <grapheme>Navigli</grapheme>
    <alias>Navìgli</alias>
  </lexeme>

  <!-- Tier 2: nearby Milan landmarks and local cuisine -->
  <lexeme>
    <grapheme>Darsena</grapheme>
    <alias>Dàrsena</alias>
  </lexeme>
  <lexeme>
    <grapheme>Porta Ticinese</grapheme>
    <alias>Porta Ticinése</alias>
  </lexeme>
  <lexeme>
    <grapheme>cotoletta alla milanese</grapheme>
    <alias>cotolétta alla milanése</alias>
  </lexeme>
  <lexeme>
    <grapheme>ossobuco</grapheme>
    <alias>ossobùco</alias>
  </lexeme>
  <lexeme>
    <grapheme>ossobuco alla milanese</grapheme>
    <alias>ossobùco alla milanése</alias>
  </lexeme>
  <lexeme>
    <grapheme>risotto alla milanese</grapheme>
    <alias>risòtto alla milanése</alias>
  </lexeme>

  <!-- Tier 3: optional local references -->
  <lexeme>
    <grapheme>Sant'Eustorgio</grapheme>
    <alias>Sant'Eustòrgio</alias>
  </lexeme>
</lexicon>
